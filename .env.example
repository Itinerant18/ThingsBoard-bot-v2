# Copy to `.env` and fill in real values. `.env` is gitignored.
# Comma-separated lists are plain CSV (no JSON, no brackets).

# --- Postgres/TimescaleDB ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB?ssl=require
# --- Redis ---
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
# --- RabbitMQ ---
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST
# --- ThingsBoard ---
TB_URL=https://your-thingsboard-host
TB_USER=
TB_PASSWORD=
DEVICE_ID=
TB_ALLOWED_HOSTS=your-thingsboard-host
# --- LLM (Anthropic) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
# --- Pinecone (optional) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=thingsboard-logs
# --- Tenant config ---
CUSTOMER_PREFIXES=
CUSTOMERS_SYNC_ENABLED=false
CUSTOMERS_TITLE_MAPPINGS=
# --- Chatbot ---
MAX_CONTEXT_TOKENS=10000
DETERMINISTIC_ANSWERS_ENABLED=true
# --- Scheduled TB telemetry sync ---
TB_SCHEDULED_SYNC_ENABLED=true
TB_SCHEDULED_SYNC_INTERVAL_MS=60000
# --- Security (blank = guard off; set + require flags true in prod) ---
WEBHOOK_HMAC_SECRET=
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRAME_ANCESTORS="'self' https://your-thingsboard-host"
JWT_SIGNING_KEY=
REQUIRE_JWT_VERIFICATION=false
REQUIRE_WEBHOOK_HMAC=false
REQUIRE_ADMIN_TOKEN=false
STRICT_CUSTOMER_MAPPING=false
WEBHOOK_MAX_SKEW_MS=300000
# --- Timescale init (true when DATABASE_URL points at TimescaleDB) ---
TIMESCALE_INIT_ENABLED=false
# --- Observability ---
METRICS_PORT=9090
TRACING_SAMPLE_RATE=0.1
# --- Evaluation (LLM-judge, async, non-blocking) ---
EVALUATION_ENABLED=false
EVALUATION_SAMPLE_RATE=1.0
# --- DB pool ---
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
