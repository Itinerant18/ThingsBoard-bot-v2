.env
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
*.py[cod]
data/
backups/

# Any env file, not just ".env" — a stray creds file must never be publishable.
*.env
!.env.example

# Frontend build
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js

# ThingsBoard dumps: contain device ACCESS_TOKENs and X509 private certs.
thingsboard_data.json
thingsboard_keys_dump.json
*_keys_dump.json
thingsboard_*.json

# Exported ThingsBoard data lands here. thingsboard_*.json above already covers the
# credential dumps, but the directory also collects hierarchy and device exports —
# real branch and customer names for several banks. Ignore the whole directory so a
# stray `git add -A` cannot publish any of it.
json_data/

# Audit measurement artifacts. Each run holds all 769 live answers — real branch
# names, device UUIDs and, in the verdict write-ups, the very outside-tenant email
# addresses the disclosure checks flag as leaks. Measurement output, not source.
# Suffix-agnostic: a .jsonl.bak slipped past an earlier `faq-audit-*.jsonl`.
faq-audit-*
codex-faq-*

# Audit harnesses carry a live ThingsBoard bearer token inline, and the token file
# is the token. Every runner that has existed so far — mine and the ones OpenCode
# writes for itself — has pasted the JWT straight into the source, so match the
# whole class rather than naming files one at a time as they appear.
# AUDIT_PROMPT.md is tracked and MUST keep its <PASTE_FRESH_TOKEN> placeholder.
fresh_token.txt
*token*.txt
run3_collect.py
update_token.py
run_audit.py
audit_*.py

# Knowledge-graph output, regenerated by /graphify.
graphify-out/

# Ad-hoc ThingsBoard attribute dumps and local tool state. keys_output.txt carries
# real bank and branch names for the live fleet; .swarm is a scratch database.
keys_output.txt
.swarm/
